---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSection from "@/components/hero";
import TestimonialSection from "@/components/testimonial.astro";
import ClientGrid, { type ClientLogo } from "@/components/client-grid";
import ClientShowcase from "@/components/client-showcase";
import FeaturesSection from "@/components/feature";
import PricingSection from "@/components/pricing";
import StepsSection from "@/components/steps";
import CoverageSection from "@/components/coverage";
import AboutSection from "@/components/about";
import FAQSection from "@/components/faq";
// import NetworkCredentials from "@/components/network-credentials.astro";
import ContactSection from "@/components/contact";
import { Image } from "astro:assets";

const logos: ClientLogo[] = [
  { name: "BPS Banyuwangi", logo: "/client/bpsbwi.svg", category: "instansi" },
  { name: "Politeknik Negeri Banyuwangi", logo: "/client/poliwangi.png", category: "instansi" },
  { name: "Stikes Banyuwangi", logo: "/client/stikesbwi.png", category: "instansi" },
  { name: "STFI", logo: "/client/stfi.png", category: "instansi" },
  { name: "PolintNet", logo: "/client/polint.png", category: "instansi" },
  { name: "SMKN 1 Glagah", logo: "/client/glagah.png", category: "sekolah" },
  { name: "SMKN 1 BWI", logo: "/client/smkn1bwi.jpg", category: "sekolah" },
  { name: "MAN 1 BWI", logo: "/client/man1bwi.jpeg", category: "sekolah" },
  { name: "SMK 17 Cluring", logo: "/client/smk17cluring.png", category: "sekolah" },
  { name: "SMKN Ihya", logo: "/client/imud.png", category: "sekolah" },
  { name: "MTS 10 BWI", logo: "/client/mts10bwi.png", category: "sekolah" },
  { name: "MTS 8 BWI", logo: "/client/mts8bwi.png", category: "sekolah" },
  { name: "CLI", logo: "/client/logocli.png", category: "bisnis" },
  { name: "Swin", logo: "/client/logo_swin.png", category: "bisnis" },
  { name: "Sewiwi", logo: "/client/sewiwi.png", category: "bisnis" },
  { name: "ISOAE", logo: "/client/isoae.png", category: "bisnis" },
  { name: "Starmedia Technology", logo: "/client/starmedia.png", category: "bisnis" },
  { name: "O-Net", logo: "/client/onet.png", category: "bisnis" },
  { name: "Satelit", logo: "/client/logo-satelit.png", category: "bisnis" },
  { name: "AYO", logo: "/client/ayo.webp", category: "bisnis" },
  { name: "Riyad", logo: "/client/riyad.png", category: "bisnis" },
  { name: "Cebersoft", logo: "/client/cebersoft.png", category: "bisnis" },
  { name: "Pandawa", logo: "/client/pandawa.jpeg", category: "bisnis" },
  { name: "BSI Banyuwangi", logo: "/client/bsibwi.webp", category: "bisnis" },
];

const partnerLogos = [
  { name: "fiberstar", logo: "/partner/fiberstar.png" },
  { name: "xl axiata", logo: "/partner/xl.jpg" },
  { name: "juniper", logo: "/partner/Juniper-logo.png" },
  { name: "mikrotik", logo: "/partner/mikrotik.jpg" },
  { name: "huawei", logo: "/partner/huawei.png" },
  { name: "swex", logo: "/partner/swex.jpg" },
  { name: "hsp", logo: "/partner/hsp.jpg" },
  { name: "iconplus", logo: "/partner/iconplus.png" },
  { name: "iforte", logo: "/partner/iforte.png" },
  { name: "linknet", logo: "/partner/linknet.png" },
  { name: "lintasarta", logo: "/partner/lintasarta.png" },
  { name: "cbn", logo: "/partner/CBN.png" },
  { name: "rbn", logo: "/partner/rbn.png" },
];
---

<BaseLayout>
  <HeroSection>
    <Image src={"/laros.png"} alt="PT Lare Osing Ndo" width={140} height={140} loading="eager" />
  </HeroSection>
  <TestimonialSection />
  <ClientGrid
    title="Pilihan Utama Lembaga dan Bisnis"
    subtitle="Dipercaya oleh instansi pemerintah, kampus, sekolah, dan pelaku usaha di Banyuwangi."
    logos={logos}
    client:visible
  />
  <FeaturesSection />
  <PricingSection client:visible />
  <StepsSection />
  <CoverageSection client:visible />
  <AboutSection client:visible />
  <FAQSection client:visible />
  {/* Disembunyikan sementara: <NetworkCredentials /> */}
  <ClientShowcase
    title="Didukung Infrastruktur & Mitra Teknologi"
    subtitle="Terhubung dengan jaringan backbone dan vendor perangkat kelas enterprise."
    client:visible
  >
    {
      partnerLogos.map((logo) => (
        <div class="bg-white dark:bg-neutral-100 rounded-xl border border-gray-200/90 dark:border-neutral-800 px-5 py-3 h-20 w-44 flex items-center justify-center shrink-0 shadow-sm overflow-hidden">
          <Image
            src={logo.logo}
            alt={`Logo ${logo.name}`}
            class="w-full h-full object-contain"
            loading="eager"
            decoding="sync"
            width={160}
            height={60}
          />
        </div>
      ))
    }
  </ClientShowcase>
  <ContactSection />
</BaseLayout>
