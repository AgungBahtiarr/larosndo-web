---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSection from "@/components/hero";
import ClientShowcase from "@/components/client-showcase";
import FeaturesSection from "@/components/feature";
import PricingSection from "@/components/pricing";
import AboutSection from "@/components/about";
import FAQSection from "@/components/faq";
import ContactSection from "@/components/contact";
import { Image } from "astro:assets";

const logos = [
  { name: "cli", logo: "/client/logocli.png" },
  { name: "swin", logo: "/client/logo_swin.png" },
  { name: "sewiwi", logo: "/client/sewiwi.png" },
  { name: "SMKN 1 Glagah", logo: "/client/glagah.png" },
  { name: "SMKN Ihya", logo: "/client/imud.png" },
  { name: "Politeknik Negeri Banyuwangi", logo: "/client/poliwangi.png" },
  { name: "O-Net", logo: "/client/onet.png" },
  { name: "SMKN 1 BWI", logo: "/client/smkn1bwi.jpg" },
  { name: "Satelit", logo: "/client/logo-satelit.png" },
  { name: "SMK 17 Cluring", logo: "/client/smk17cluring.png" },
  { name: "Stikes", logo: "/client/stikesbwi.png" },
  { name: "MAN 1 BWI", logo: "/client/man1bwi.jpeg" },
  { name: "STFI", logo: "/client/stfi.png" },
  { name: "MTS 10 BWI", logo: "/client/mts10bwi.png" },
  { name: "AYO", logo: "/client/ayo.webp" },
  { name: "Riyad", logo: "/client/riyad.png" },
  { name: "cebersoft", logo: "/client/cebersoft.png" },
  { name: "sewiwi", logo: "/client/sewiwi.png" },
  { name: "Pandawa", logo: "/client/pandawa.jpeg" },
];

const partnerLogos = [
  { name: "fiberstar", logo: "/partner/fiberstar.png" },
  { name: "xl axiata", logo: "/partner/xl.jpg" },
  { name: "juniper", logo: "/partner/Juniper-logo.png" },
  { name: "mikrotik", logo: "/partner/mikrotik.jpg" },
  { name: "huawei", logo: "/partner/huawei.png" },
  { name: "hsp", logo: "/partner/hsp.jpg" },
  { name: "iconplus", logo: "/partner/iconplus.png" },
  { name: "iforte", logo: "/partner/iforte.png" },
  { name: "linknet", logo: "/partner/linknet.png" },
  { name: "lintasarta", logo: "/partner/lintasarta.png" },
  { name: "cbn", logo: "/partner/CBN.png" },
  { name: "rbn", logo: "/partner/rbn.png" },
];
---

<BaseLayout>
  <HeroSection client:load>
    <Image src={"/laros.png"} alt="Laros" width={150} height={150} />
  </HeroSection>
  <!-- <ClientReviews /> -->
  <div>
    <script src="https://static.elfsight.com/platform/platform.js" async
    ></script>
    <div
      class="elfsight-app-193b3701-5f67-4485-bb25-0a8c09b0269a"
      data-elfsight-app-lazy
    >
    </div>
  </div>
  <ClientShowcase
    logos={logos}
    title="Pilihan Utama Lembaga Dan Bisnis"
    client:load
  >
    {
      logos
        .concat()
        .map((logo) => (
          <Image
            src={logo.logo}
            alt={`${logo.name} logo`}
            class="max-w-[310px] max-h-[100px] object-contain"
            loading="lazy"
            width={500}
            height={500}
          />
        ))
    }</ClientShowcase
  >
  <FeaturesSection client:load />
  <PricingSection client:load />
  <AboutSection client:load />
  <FAQSection client:load />
  <ClientShowcase logos={partnerLogos} title="Partner Kami" client:load>
    {
      partnerLogos
        .concat()
        .map((logo, index) => (
          <Image
            src={logo.logo}
            alt={`${logo.name} logo`}
            class="max-w-[310px] max-h-[100px] object-contain"
            loading="lazy"
            width={500}
            height={500}
          />
        ))
    }
  </ClientShowcase>
  <ContactSection client:load />
</BaseLayout>
