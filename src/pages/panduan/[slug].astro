---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { guideArticles, type GuideArticle } from "@/data/seo-pages";

export function getStaticPaths() {
  return guideArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: GuideArticle };
const related = guideArticles.filter((a) => a.slug !== article.slug);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.description,
  datePublished: article.publishedAt,
  author: {
    "@type": "Organization",
    name: "PT Lare Osing Ndo",
    url: "https://laros.net.id",
  },
  publisher: {
    "@type": "Organization",
    name: "PT Lare Osing Ndo",
    logo: {
      "@type": "ImageObject",
      url: "https://laros.net.id/laros.png",
    },
  },
  mainEntityOfPage: `https://laros.net.id/panduan/${article.slug}`,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Beranda", item: "https://laros.net.id/" },
    { "@type": "ListItem", position: 2, name: "Panduan", item: "https://laros.net.id/panduan" },
    {
      "@type": "ListItem",
      position: 3,
      name: article.title,
      item: `https://laros.net.id/panduan/${article.slug}`,
    },
  ],
};
---

<BaseLayout
  title={`${article.title} | PT Lare Osing Ndo`}
  description={article.description}
  type="article"
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </Fragment>

  <article class="bg-white dark:bg-neutral-950 py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-gray-500 dark:text-gray-400">
        <a href="/" class="hover:text-brand">Beranda</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/panduan" class="hover:text-brand">Panduan</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-gray-900 dark:text-white font-medium">{article.category}</span>
      </nav>

      <header class="mb-10">
        <div class="flex items-center gap-3 text-xs font-medium text-gray-500 dark:text-gray-400 mb-3">
          <span class="text-brand font-semibold">{article.category}</span>
          <span aria-hidden="true">•</span>
          <time datetime={article.publishedAt}>{article.publishedAt}</time>
          <span aria-hidden="true">•</span>
          <span>{article.readTime}</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
          {article.title}
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          {article.description}
        </p>
      </header>

      <div class="space-y-8">
        {
          article.sections.map((section) => (
            <section>
              <h2 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white mb-3">
                {section.heading}
              </h2>
              <div class="space-y-3 text-gray-700 dark:text-gray-300 leading-relaxed">
                {section.paragraphs.map((p) => <p>{p}</p>)}
              </div>
              {section.bullets && (
                <ul class="mt-4 space-y-2 list-disc pl-5 text-gray-700 dark:text-gray-300">
                  {section.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
            </section>
          ))
        }
      </div>

      <div class="mt-12 p-6 rounded-2xl bg-gray-50 dark:bg-neutral-900 border border-gray-200 dark:border-neutral-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-gray-900 dark:text-white">
            Siap pasang WiFi tanpa FUP di Banyuwangi?
          </h2>
          <p class="text-sm text-gray-600 dark:text-gray-300">
            Pilih paket rumah atau bisnis dan cek ketersediaan ODP di alamat Anda.
          </p>
        </div>
        <a
          href="/#pricing"
          class="inline-flex items-center justify-center shrink-0 min-h-11 px-5 py-2.5 rounded-lg bg-brand hover:bg-brand-hover text-brand-foreground font-semibold transition-colors"
        >
          Lihat Paket Internet
        </a>
      </div>

      <aside class="mt-12 pt-8 border-t border-gray-200 dark:border-neutral-800">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-4">
          Panduan Lainnya
        </h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {
            related.map((item) => (
              <a
                href={`/panduan/${item.slug}`}
                class="block p-4 rounded-xl border border-gray-200 dark:border-neutral-800 hover:border-brand transition-colors"
              >
                <p class="text-xs font-semibold text-brand mb-1">{item.category}</p>
                <p class="font-semibold text-gray-900 dark:text-white text-sm">
                  {item.title}
                </p>
              </a>
            ))
          }
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
