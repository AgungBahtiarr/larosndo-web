---
import "@/styles/globals.css";
import Navbar from "@/components/navbar";
import Footer from "@/components/Footer.astro";
import FloatingWA from "@/components/FloatingWA.astro";
import { SEO } from "astro-seo";
import reviewsData from "@/data/reviews.json";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title = "PT Lare Osing Ndo | Pasang WiFi & Internet Fiber Banyuwangi",
  description = "Pasang WiFi & internet fiber optik cepat di Banyuwangi mulai Rp 100.000/bulan tanpa FUP. Layanan ISP resmi untuk rumah, sekolah, & bisnis 24/7.",
  image = "/laros.png",
  type = "website",
  noindex = false,
} = Astro.props as Props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const currentYear = new Date().getFullYear();

const banyuwangiAreas = [
  "Banyuwangi Kota",
  "Rogojampi",
  "Glagah",
  "Giri",
  "Kabat",
  "Cluring",
  "Genteng",
  "Srono",
  "Muncar",
  "Singojuruh",
  "Kalibaru",
  "Songgon",
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Pilihan kecepatan internet apa saja yang tersedia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Untuk paket rumah, tersedia pilihan mulai 15 Mbps (Rp 100.000/bulan), 25 Mbps (Rp 150.000/bulan), hingga 50 Mbps (Rp 200.000/bulan). Untuk kebutuhan sekolah dan bisnis, tersedia paket Dedicated hingga 1 Gbps+ sesuai kebutuhan.",
      },
    },
    {
      "@type": "Question",
      name: "Apakah ada batasan kuota (FUP) pada paket internet?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Tidak ada. Semua paket internet PT Lare Osing Ndo bersifat unlimited tanpa Fair Usage Policy (FUP) dan tanpa penurunan kecepatan.",
      },
    },
    {
      "@type": "Question",
      name: "Apakah tersedia layanan khusus untuk bisnis atau sekolah?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ya, kami menyediakan layanan Dedicated Internet dengan SLA terjamin, dukungan teknis prioritas, opsi IP Public statis, serta penawaran khusus untuk instansi pendidikan dan perusahaan.",
      },
    },
    {
      "@type": "Question",
      name: "Wilayah mana saja yang sudah terjangkau jaringan PT Lare Osing Ndo?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Jaringan fiber optik kami melayani wilayah Kabupaten Banyuwangi, meliputi Banyuwangi Kota, Rogojampi, Glagah, Kabat, Cluring, Genteng, dan sekitarnya. Hubungi kami untuk pengecekan titik ODP terdekat di alamat Anda.",
      },
    },
    {
      "@type": "Question",
      name: "Berapa lama proses pemasangan baru berlangsung?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Setelah konfirmasi alamat dan ketersediaan jaringan, tim teknisi lokal kami dapat melakukan instalasi dalam 1×24 jam.",
      },
    },
  ],
};
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.href}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          title: title,
          type: type,
          image: imageURL.href,
          url: canonicalURL.href,
        },
        optional: {
          description: description,
          locale: "id_ID",
          siteName: "PT Lare Osing Ndo",
        },
        image: {
          alt: "PT Lare Osing Ndo - ISP Fiber Optik Banyuwangi",
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: title,
        description: description,
        image: imageURL.href,
        imageAlt: "PT Lare Osing Ndo - Pasang WiFi & Internet Fiber Banyuwangi",
      }}
      extend={{
        link: [
          { rel: "icon", type: "image/x-icon", href: "/favicon/favicon.ico" },
          {
            rel: "icon",
            type: "image/png",
            sizes: "32x32",
            href: "/favicon/favicon-32x32.png",
          },
          {
            rel: "icon",
            type: "image/png",
            sizes: "16x16",
            href: "/favicon/favicon-16x16.png",
          },
          {
            rel: "apple-touch-icon",
            sizes: "180x180",
            href: "/favicon/apple-touch-icon.png",
          },
          { rel: "sitemap", href: "/sitemap-index.xml" },
          { rel: "ard", href: "/.well-known/ard.json" },
        ],
        meta: [
          {
            name: "viewport",
            content: "width=device-width, initial-scale=1.0",
          },
          { name: "generator", content: Astro.generator },
          {
            name: "keywords",
            content:
              "pasang wifi banyuwangi, internet banyuwangi, ISP Banyuwangi, internet fiber optik banyuwangi, wifi rumah banyuwangi, wifi gaming banyuwangi, low latency gaming, internet murah banyuwangi, internet unlimited tanpa FUP, internet dedicated banyuwangi, ip transit banyuwangi, PT Lare Osing Ndo, pasang wifi rogojampi, pasang wifi genteng, provider internet terbaik banyuwangi",
          },
          { name: "author", content: "PT Lare Osing Ndo" },
          { name: "publisher", content: "PT Lare Osing Ndo" },
          {
            name: "copyright",
            content: `© ${currentYear} PT Lare Osing Ndo. All rights reserved.`,
          },
          {
            name: "robots",
            content: noindex
              ? "noindex, nofollow"
              : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
          },
          {
            name: "googlebot",
            content: noindex ? "noindex, nofollow" : "index, follow",
          },
          {
            name: "bingbot",
            content: noindex ? "noindex, nofollow" : "index, follow",
          },
          { name: "geo.region", content: "ID-JI" },
          { name: "geo.placename", content: "Banyuwangi" },
          { name: "geo.position", content: "-8.3006526;114.2898398" },
          { name: "ICBM", content: "-8.3006526, 114.2898398" },
          { name: "theme-color", content: "#fb923c" },
          { name: "msapplication-TileColor", content: "#fb923c" },
        ],
      }}
    />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (stored === "dark" || (!stored && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>

    <!-- Structured Data - Organization -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "PT Lare Osing Ndo",
        alternateName: ["Laros Net", "LAROS", "LarosNdo"],
        url: "https://laros.net.id",
        logo: "https://laros.net.id/laros.png",
        description:
          "Penyedia layanan internet (ISP) berizin resmi di Banyuwangi dengan koneksi fiber optik berkecepatan tinggi untuk rumah, sekolah, dan bisnis.",
        address: {
          "@type": "PostalAddress",
          streetAddress:
            "Perum Griya Gurit Permai Blok H 14 Pengatigan, Rogojampi",
          addressLocality: "Banyuwangi",
          addressRegion: "Jawa Timur",
          postalCode: "68462",
          addressCountry: "ID",
        },
        contactPoint: {
          "@type": "ContactPoint",
          telephone: "+6282141623298",
          email: "isun@laros.ae",
          contactType: "customer service",
          areaServed: "ID",
          availableLanguage: ["Indonesian"],
        },
        sameAs: [
          "https://www.facebook.com/larosnet",
          "https://www.instagram.com/larosnet",
        ],
        areaServed: banyuwangiAreas.map((area) => ({
          "@type": "AdministrativeArea",
          name: area,
        })),
      })}
    />

    <!-- Structured Data - Local Business & OfferCatalog -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        name: "PT Lare Osing Ndo",
        url: "https://laros.net.id",
        image: "https://laros.net.id/laros.png",
        telephone: "+6282141623298",
        email: "isun@laros.ae",
        address: {
          "@type": "PostalAddress",
          streetAddress:
            "Perum Griya Gurit Permai Blok H 14 Pengatigan, Rogojampi",
          addressLocality: "Banyuwangi",
          addressRegion: "Jawa Timur",
          postalCode: "68462",
          addressCountry: "ID",
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: -8.3006526,
          longitude: 114.2898398,
        },
        openingHoursSpecification: {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday",
          ],
          opens: "00:00",
          closes: "23:59",
        },
        priceRange: "Rp 100.000 - Rp 200.000+",
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: reviewsData.rating,
          reviewCount: reviewsData.totalReviews,
          bestRating: 5,
          worstRating: 1,
        },
        hasOfferCatalog: {
          "@type": "OfferCatalog",
          name: "Paket Internet & WiFi Fiber Banyuwangi",
          itemListElement: [
            {
              "@type": "Offer",
              name: "Paket Basic 15 Mbps",
              description: "Internet fiber optik rumah unlimited tanpa FUP hingga 15 Mbps",
              price: "100000",
              priceCurrency: "IDR",
            },
            {
              "@type": "Offer",
              name: "Paket Pro 25 Mbps",
              description: "Internet fiber optik rumah unlimited tanpa FUP hingga 25 Mbps",
              price: "150000",
              priceCurrency: "IDR",
            },
            {
              "@type": "Offer",
              name: "Paket Premium 50 Mbps",
              description: "Internet fiber optik rumah unlimited tanpa FUP hingga 50 Mbps",
              price: "200000",
              priceCurrency: "IDR",
            },
            {
              "@type": "Offer",
              name: "Internet Dedicated, IP Transit BGP & Metro-E",
              description: "Layanan konektivitas korporat, sekolah, dan instansi dengan SLA 99,5% dan multi-link backbone",
            },
          ],
        },
      })}
    />

    <!-- Structured Data - FAQPage -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    />

    <!-- Website Schema -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "PT Lare Osing Ndo",
        alternateName: "LAROS",
        url: "https://laros.net.id",
      })}
    />
  </head>

  <body class="bg-white dark:bg-neutral-950 transition-colors duration-300">
    <Navbar client:load />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingWA />
  </body>
</html>
