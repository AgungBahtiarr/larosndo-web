---
import { ShieldCheckIcon, GlobeIcon } from "lucide-react";

const metrics = [
  { value: "AS149714", label: "Nomor AS sendiri (APNIC)" },
  { value: "IPv4 + IPv6", label: "Prefix IP sendiri" },
  { value: "RPKI Valid", label: "Routing teramankan (ROA)" },
  { value: "100+ Peers", label: "Peering BGP aktif" },
  { value: "15+ CDN", label: "Cloud dan CDN terhubung" },
  { value: "6+ IXP", label: "Titik pertukaran trafik" },
];

const credentials = [
  {
    title: "Berizin Komdigi",
    desc: "Izin penyelenggara ISP dari Kementerian Komdigi.",
    logos: [{ src: "/credentials/komdigi.png", alt: "Logo Komdigi" }],
  },
  {
    title: "MANRS Participant",
    desc: "Peserta MANRS sejak September 2023.",
    logos: [{ src: "/credentials/manrs.png", alt: "Logo MANRS" }],
  },
  {
    title: "Anggota APJII",
    desc: "Asosiasi Penyelenggara Jasa Internet Indonesia.",
    logos: [{ src: "/credentials/apjii.png", alt: "Logo APJII" }],
  },
  {
    title: "Anggota Jartatel",
    desc: "Asosiasi Jaringan Tetap Telekomunikasi Indonesia.",
    logos: [{ src: "/credentials/jartatel.png", alt: "Logo Jartatel" }],
  },
  {
    title: "Anggota IDNIC",
    desc: "Registri internet nasional di bawah APNIC.",
    logos: [{ src: "/credentials/idnic.png", alt: "Logo IDNIC" }],
  },
  {
    title: "RPKI Valid (ROA)",
    desc: "Rute IP bertanda tangan kriptografis.",
    logos: [{ src: "/credentials/rpki.png", alt: "Logo RPKI" }],
  },
  {
    title: "Terdaftar di IRR",
    desc: "Terdaftar di ALTDB dan RADB.",
    logos: [
      { src: "/credentials/altdb.png", alt: "Logo ALTDB" },
      { src: "/credentials/radb.png", alt: "Logo RADB" },
    ],
  },
  {
    title: "Profil PeeringDB",
    desc: "Profil peering publik untuk interkoneksi.",
    logos: [{ src: "/credentials/peeringdb.png", alt: "Logo PeeringDB" }],
  },
];

const ixps = [
  "IIX Jakarta",
  "DE-CIX Jakarta",
  "OpenIXP",
  "ODIX",
  "BIX Jakarta",
  "SWIN Exchange",
  "JKT-IX",
];
---

<section
  id="credentials"
  class="py-20 bg-gray-50 dark:bg-neutral-900/60 border-t border-gray-100 dark:border-neutral-800"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12">
      <div class="inline-flex items-center gap-2 rounded-full border border-gray-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 px-3.5 py-1 text-xs font-semibold text-brand mb-4">
        <ShieldCheckIcon className="h-3.5 w-3.5" aria-hidden="true" />
        AS149714 &middot; Terverifikasi Publik
      </div>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-3">
        Infrastruktur &amp; Kredensial Jaringan
      </h2>
      <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base leading-relaxed">
        Infrastruktur mandiri dengan ASN sendiri, keamanan routing terverifikasi,
        serta keanggotaan dan kepatuhan industri yang dapat diverifikasi secara publik.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
      {
        metrics.map((m) => (
          <div class="bg-white dark:bg-neutral-900 border border-gray-200/90 dark:border-neutral-800 rounded-xl p-4 sm:p-5 shadow-sm">
            <div class="text-lg sm:text-xl font-bold tabular-nums text-gray-900 dark:text-white mb-1">
              {m.value}
            </div>
            <div class="text-xs text-gray-600 dark:text-gray-400 leading-snug">
              {m.label}
            </div>
          </div>
        ))
      }
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      {
        credentials.map((cred) => (
          <div class="bg-white dark:bg-neutral-900 border border-gray-200/90 dark:border-neutral-800 rounded-2xl p-4 shadow-sm flex flex-col">
            <div class="w-full h-24 rounded-xl bg-white dark:bg-neutral-100 border border-gray-100 dark:border-neutral-700 px-4 py-3 flex items-center justify-center gap-3 mb-4 overflow-hidden">
              {cred.logos.map((logo) => (
                <img
                  src={logo.src}
                  alt={logo.alt}
                  loading="lazy"
                  class={
                    cred.logos.length > 1
                      ? "max-w-[46%] max-h-14 object-contain"
                      : "max-w-full max-h-16 object-contain"
                  }
                />
              ))}
            </div>
            <div class="text-sm font-semibold text-gray-900 dark:text-white">
              {cred.title}
            </div>
            <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed mt-1">
              {cred.desc}
            </p>
          </div>
        ))
      }
    </div>

    <div class="bg-white dark:bg-neutral-900 border border-gray-200/90 dark:border-neutral-800 rounded-2xl p-6 sm:p-8 shadow-sm flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      <div class="max-w-xl">
        <div class="flex items-center gap-2.5 mb-2">
          <div class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-brand/10 shrink-0">
            <GlobeIcon className="h-5 w-5 text-brand" aria-hidden="true" />
          </div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            Terhubung Langsung ke IXP
          </h3>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Dengan ASN sendiri (<span class="font-semibold text-gray-900 dark:text-white">AS149714</span>),
          LAROS mengelola rute lalu lintas data secara mandiri untuk akses yang
          lebih cepat dan efisien ke berbagai jaringan lokal maupun global.
        </p>
        <p class="text-[11px] text-gray-500 dark:text-gray-400 leading-relaxed mt-3">
          Sumber: data publik PeeringDB, bgp.tools, bgp.he.net, daftar peserta
          MANRS, apjii.or.id/anggota, &amp; RIPEstat. Izin Komdigi dan
          keanggotaan Jartatel berdasarkan registrasi resmi perusahaan.
        </p>
      </div>

      <div class="flex flex-wrap gap-2 lg:max-w-md lg:justify-end">
        {
          ixps.map((ixp) => (
            <span class="inline-flex items-center px-3.5 py-2 rounded-lg text-xs font-medium bg-gray-100 dark:bg-neutral-800 text-gray-800 dark:text-gray-200 border border-gray-200/80 dark:border-neutral-700">
              {ixp}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
